[program:agencyos-worker]
process_name=%(program_name)s_%(process_num)02d
command=php /var/www/agencyos/artisan queue:work --sleep=3 --tries=3 --timeout=120 --max-time=3600
directory=/var/www/agencyos
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
numprocs=1
redirect_stderr=true
stdout_logfile=/var/log/supervisor/agencyos-worker.log
stopwaitsecs=3600
